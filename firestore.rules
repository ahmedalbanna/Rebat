rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /subscriptions/{subId} {
      allow read: if request.auth != null && request.auth.uid == subId; // ID is userId
      allow write: if request.auth != null && request.auth.uid == subId;
    }

    match /trips/{tripId} {
      allow read: if request.auth != null; // Ideally restrict to involved parties
      allow write: if request.auth != null; // Ideally restrict to driver or admin
    }
  }
}
